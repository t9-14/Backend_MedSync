PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=medsync
DB_SSL=false
# Set either the local CA path or the PEM contents in DB_SSL_CA when DB_SSL=true.
DB_SSL_CA_PATH=
# DB_SSL_CA=

# Generate separate random values with at least 32 characters each.
JWT_ACCESS_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_TOKEN_SECRET=replace_with_a_different_random_secret_at_least_32_chars
ACCESS_TOKEN_EXPIRES_IN=900s
REFRESH_TOKEN_EXPIRES_IN=7d
