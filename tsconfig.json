{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2021",
    "lib": ["es2021"],
    "rootDir": "./src",
    "outDir": "./dist",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/transfer-items/**",
    "src/disposal-certificates/**",
    "src/auth/auth.service.ts",
    "src/auth/jwt-strategy.ts",
    "src/auth/jwt-auth.guard.ts"
  ]
}
